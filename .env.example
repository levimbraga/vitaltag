# Banco de dados (Supabase). DATABASE_URL usa o pooler (porta 6543) e
# DIRECT_URL a conexão direta (porta 5432), exigida pelas migrações.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Auth.js. Gere o segredo com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# URL base usada nos links públicos e no conteúdo do QR Code
APP_URL="http://localhost:3000"

# E-mail. EMAIL_PROVIDER aceita "console" (apenas registra no terminal) ou "resend".
EMAIL_PROVIDER="console"
EMAIL_FROM="VitalTag <nao-responda@exemplo.com>"
RESEND_API_KEY=""
